generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id             String        @id
  username       String        @unique
  email          String        @unique
  displayName    String?
  passwordHash   String?
  role           String        @default("VIEWER")
  ssoId          String?       @unique
  ssoGroups      String        @db.Text
  preferences    String        @default("{}")
  permissions    String        @default("[]")
  revokedPermissions String    @default("[]")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  loans          Loan[]
  sessions       Session[]
  issueReports   DeviceIssue[] @relation("IssueReporter")
  assignedIssues DeviceIssue[] @relation("IssueAssignee")
  issueAssignments IssueAssignee[]
  issueComments  IssueComment[]
  issueActivities IssueActivity[]
  areas          AreaMember[]
  areaEditors    AreaEditor[]
  issueTypeMembers  IssueTypeMember[]
  issueTypeEditors  IssueTypeEditor[]
  adminDevices   Device[]        @relation("DeviceAdmin")
  primaryIssues  DeviceIssue[]   @relation("IssuePrimaryAssignee")
  deletedIssues  DeviceIssue[]   @relation("IssueDeletedBy")
  internalNotes  IssueInternalNote[]
  templateAssignments IssueTemplateAssignee[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
  @@index([userId])
}

model Device {
  id             String               @id @default(cuid())
  inventoryId    String               @unique
  serialNumber   String?
  manufacturer   String?
  model          String?
  /// Geräteart (DESKTOP, LAPTOP, TABLET, PRINTER, SERVER, ...). Werte siehe
  /// backend/src/services/deviceCategories.js. Sieht `icon` nicht gesetzt,
  /// wird daraus das Standard-Symbol abgeleitet.
  category       String               @default("OTHER")
  /// Explizit gewähltes Symbol (SWITCH, TABLET, LAPTOP, DESKTOP, PRINTER,
  /// SERVER). Leer = Standard (Ableitung aus `category`).
  icon           String?
  /// Geräte-/Hostname für die Anzeige in „Mein Gerät".
  hostname       String?
  /// Sichtbarkeit für normale Benutzer: ALL (alle) | STAFF (IT) | ADMIN
  visibility     String               @default("ALL")
  description    String?
  status         String               @default("AVAILABLE")
  /// Manuell gesetzter Status ist vor automatischen Ticket-Zuständen geschützt.
  statusLocked   Boolean              @default(false)
  defectNote     String?
  ipAddress      String?
  macAddress     String?
  isLendable     Boolean              @default(false)
  isReportable   Boolean              @default(false)
  updatesEnabled Boolean              @default(false)
  roomId         String?
  room           Room?                @relation(fields: [roomId], references: [id], onDelete: SetNull)
  /// Gerätebereich („Bereich" im Konzept): steuert Ausleihe, Meldungs-
  /// Zuordnung und Bereichs-Benachrichtigungen.
  areaId         String?
  area           Area?                @relation(fields: [areaId], references: [id], onDelete: SetNull)
  /// Zuständiger Administrator/ITler für dieses Gerät.
  adminId        String?
  admin          User?                @relation("DeviceAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  purchaseDate   DateTime?
  warrantyEnd    DateTime?
  labels         String               @default("[]")
  images         String               @default("[]")
  qrCode         String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  loans          Loan[]
  history        DeviceHistory[]
  issues         DeviceIssue[]
  issueLinks     DeviceIssueDevice[]
  updateResults  DeviceUpdateResult[]

  @@index([areaId])
  @@index([status])
}

model DeviceIssue {
  id            String          @id
  type          String          @default("DEVICE") // DEVICE | PERSONAL | WLAN | SOFTWARE
  /// Erstes/führendes Gerät eines Schulgerät-Tickets (Abwärtskompatibilität,
  /// Suche und Listenansichten). Alle weiteren Geräte stehen in `extraDevices`.
  deviceId      String?
  device        Device?         @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  extraDevices  DeviceIssueDevice[]
  reporterId    String?
  reporter      User?           @relation("IssueReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  reporterEmail String?
  /// Leitender/zuständiger Bearbeiter (Abwärtskompatibilität). Alle Bearbeiter
/// stehen zusätzlich in `assignments`; dieser Wert zeigt immer auf den ersten
/// Eintrag daraus, damit ältere Auswertungen weiter funktionieren.
  assigneeId    String?
  assignee      User?           @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  /// Hauptverantwortlicher (Koordination). Bleibt zusätzlich in `assignments`.
  primaryAssigneeId String?
  primaryAssignee User?        @relation("IssuePrimaryAssignee", fields: [primaryAssigneeId], references: [id], onDelete: SetNull)
  /// Alle Bearbeiter eines Tickets (Mehrfachzuweisung).
  assignments   IssueAssignee[]
  /// Verwendete Ticket-Vorlage (optional). `templateName` ist eine Momentaufnahme,
  /// damit spätere Vorlagenänderungen bestehende Tickets nicht verändern.
  templateId    String?
  template      IssueTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateName  String?
  /// Papierkorb: gesetzt = soft-gelöscht. Endgültiges Löschen nur durch ADMIN.
  deletedAt     DateTime?
  deletedById   String?
  deletedBy     User?           @relation("IssueDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  roomId        String?
  room          Room?           @relation(fields: [roomId], references: [id], onDelete: SetNull)
  /// Bereich, dem die Meldung zugeordnet ist (Basis: Bereich des gemeldeten
  /// Geräts) – Grundlage der Bereichs-Benachrichtigung.
  areaId        String?
  area          Area?           @relation(fields: [areaId], references: [id], onDelete: SetNull)
  softwareName  String?
  title         String
  description   String
  priority      String          @default("NORMAL")
  status        String          @default("OPEN") // OPEN | IN_PROGRESS | WAITING | CLOSED
  resolution    String?
  attachments   String          @default("[]")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  comments      IssueComment[]
  activities    IssueActivity[]
  internalNotes IssueInternalNote[]

  @@index([deviceId, status])
  @@index([reporterId])
  @@index([assigneeId])
  @@index([primaryAssigneeId])
  @@index([type, status])
  @@index([roomId])
  @@index([areaId])
  @@index([deletedAt])
}

/// Verknüpfungstabelle: Ein Ticket (Ticketart DEVICE) kann mehrere Schulgeräte
/// betreffen. Das erste Gerät wird zusätzlich in `DeviceIssue.deviceId`
/// geführt, alle Geräte stehen hier.
model DeviceIssueDevice {
  issueId  String
  deviceId String
  issue    DeviceIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  device   Device      @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@id([issueId, deviceId])
  @@index([deviceId])
}

/// Verknüpfungstabelle: Ein Ticket kann mehreren Bearbeitern (ITlern)
/// gleichzeitig zugewiesen sein. `DeviceIssue.assigneeId` bleibt als
/// Abwärtskompatibilität auf den ersten Eintrag gesetzt.
model IssueAssignee {
  issueId    String
  userId     String
  issue      DeviceIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime    @default(now())

  @@id([issueId, userId])
  @@index([userId])
}

model IssueActivity {
  id        String      @id @default(cuid())
  issueId   String
  issue     DeviceIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   String?
  createdAt DateTime    @default(now())

  @@index([issueId, createdAt])
}

model IssueComment {
  id        String      @id @default(cuid())
  issueId   String
  issue     DeviceIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime    @default(now())
}

/// Interne Notiz: nur für berechtigte IT/Administratoren sichtbar, löst keine
/// Melder-Benachrichtigung aus.
model IssueInternalNote {
  id        String      @id @default(cuid())
  issueId   String
  issue     DeviceIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime    @default(now())

  @@index([issueId, createdAt])
}

// ─── Ticket-Vorlagen ─────────────────────────────────────────────────────────
// Vorlagen ergänzen die bestehenden Ticketformulare um Vorgaben. Sie ersetzen
// keine Geräte-/Raum-/Softwareauswahl. Änderungen an einer Vorlage wirken nur
// auf neue Tickets; bestehende Tickets behalten ihre Momentaufnahme.

model IssueTemplate {
  id                  String   @id @default(cuid())
  name                String
  description         String?
  icon                String?
  color               String?
  active              Boolean  @default(true)
  sortOrder           Int      @default(0)
  /// Zuordnung: Ticketart (PERSONAL/WLAN/SOFTWARE) oder Gerätebereich (areaId).
  type                String?
  areaId              String?
  area                Area?    @relation(fields: [areaId], references: [id], onDelete: SetNull)
  /// Sichtbarkeit: ALL | STAFF | ADMIN plus optionale SSO-Gruppen.
  visibility          String   @default("ALL")
  visibilityGroups    String   @default("[]") @db.Text
  priority            String   @default("NORMAL")
  descriptionHint     String?  @db.Text
  fieldHelp           String   @default("{}") @db.Text
  confirmationMessage String?  @db.Text
  attachmentsAllowed  Boolean  @default(true)
  maxAttachments      Int      @default(10)
  createdById         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  assignees           IssueTemplateAssignee[]
  recipients          IssueTemplateRecipient[]
  versions            IssueTemplateVersion[]
  issues              DeviceIssue[]

  @@index([type, active])
  @@index([areaId, active])
}

model IssueTemplateAssignee {
  templateId String
  userId     String
  template   IssueTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([templateId, userId])
  @@index([userId])
}

model IssueTemplateRecipient {
  templateId String
  email      String
  name       String?
  template   IssueTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@id([templateId, email])
}

/// Versionierte Momentaufnahme einer Vorlage (JSON). Wird bei jeder Änderung
/// angelegt, damit die Administration Änderungen nachvollziehen kann.
model IssueTemplateVersion {
  id          String        @id @default(cuid())
  templateId  String
  template    IssueTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version     Int
  snapshot    String        @db.LongText
  createdById String?
  createdAt   DateTime      @default(now())

  @@unique([templateId, version])
  @@index([templateId, createdAt])
}

model Room {
  id          String         @id
  name        String
  building    String?
  description String?
  devices     Device[]
  updates     DeviceUpdate[] // Many-to-many relationship with DeviceUpdate
  issues      DeviceIssue[]
  areas       Area[]
}

// ─── Gerätebereiche ──────────────────────────────────────────────────────────
// „Bereich" aus dem Konzept „Mein Gerät": organisatorische Gruppierung von
// Geräten (z. B. „Klasse 5a iPads"). Basis für Ausleihe nach Bereich,
// Bereichs-Mitglieder (zuständige IT/ADMIN) und Bereichs-Benachrichtigungen.

model Area {
  id                  String        @id
  name                String        @unique
  description         String?
  /// Raum/Standort des Bereichs (optional).
  roomId              String?
  room                Room?         @relation(fields: [roomId], references: [id], onDelete: SetNull)
  /// Ausleihe für diesen Bereich erlaubt.
  lendEnabled         Boolean       @default(true)
  /// Einzelgeräteverwaltung: Geräte des Bereichs dürfen einzeln verliehen werden.
  individualManagement Boolean       @default(true)
  /// Mitglieder des Bereichs per E-Mail über neue Tickets informieren.
  issueMailEnabled    Boolean       @default(false)
  /// E-Mail-Empfänger für Tickets aus diesem Bereich (nur STAFF/ADMIN).
  members             AreaMember[]
  /// Zuständige/Bearbeiter für Tickets aus diesem Bereich (nur STAFF/ADMIN).
  /// Diese Personen dürfen Tickets der Geräte des Bereichs bearbeiten.
  editors             AreaEditor[]
  devices             Device[]
  loans               Loan[]
  issues              DeviceIssue[]
  templates           IssueTemplate[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([roomId])
}

/// Bereichszuordnung eines Benutzers (nur STAFF/ADMIN sind zulässig,
/// Prüfung in routes/areas.js).
model AreaMember {
  areaId     String
  userId     String
  area       Area     @relation(fields: [areaId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([areaId, userId])
  @@index([userId])
}

/// Bearbeiter eines Bereichs (nur STAFF/ADMIN, Prüfung in routes/areas.js):
/// dürfen Tickets bearbeiten, deren betroffene Geräte im Bereich liegen
/// (Konzept „Mein Gerät" – Bereichs-Rechte). Getrennt von den E-Mail-Empfängern
/// (`AreaMember`).
model AreaEditor {
  areaId     String
  userId     String
  area       Area     @relation(fields: [areaId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([areaId, userId])
  @@index([userId])
}

// ─── Ticketart-Zuständigkeiten ───────────────────────────────────────────────
// Zuständigkeiten je Ticketart (Netzwerk/WLAN, Dienstgerät, Software) analog zu
// den Bereichs-Zuständigkeiten: E-Mail-Empfänger und Bearbeiter je Ticketart.
// Schulgerät-Tickets (DEVICE) laufen weiter über die Bereiche.

/// E-Mail-Empfänger für neue Tickets einer Ticketart (nur STAFF/ADMIN).
model IssueTypeMember {
  type       String
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([type, userId])
  @@index([userId])
}

/// Bearbeiter einer Ticketart (nur STAFF/ADMIN): dürfen Tickets dieser Art
/// bearbeiten, ohne über einen Bereich (Gerät) zugeordnet zu sein.
model IssueTypeEditor {
  type       String
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([type, userId])
  @@index([userId])
}

model Loan {
  id                String    @id
  /// Konkretes Gerät. Bei einer Modellanfrage (Nutzer wünscht sich z. B. ein
  /// „Lenovo ThinkPad") bleibt das leer – erst bei der Freigabe weist die IT ein
  /// Gerät zu.
  deviceId          String?
  device            Device?   @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  /// Gewünschte Geräteart der Modellanfrage (LAPTOP, TABLET, ...).
  requestedCategory String?
  /// Freitext der Modellanfrage, z. B. „Lenovo ThinkPad T14" oder „iPad".
  requestedModel    String?
  /// Angefragter Bereich. Die Verwaltung weist daraus ein konkretes Gerät zu.
  areaId            String?
  area              Area?     @relation(fields: [areaId], references: [id], onDelete: SetNull)
  userId            String?
  user              User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  borrowerName      String    @default("")
  borrowerContact   String?
  borrowerGroup     String?
  startDate         DateTime  @default(now())
  dueDate           DateTime
  returnDate        DateTime?
  notes             String?
  requestReason     String?
  decisionMessage   String?
  decidedAt         DateTime?
  decidedById       String?
  status            String    @default("ACTIVE")
  archivedAt        DateTime?

  @@index([status, dueDate])
  @@index([userId, status])
  @@index([deviceId])
  @@index([areaId])
}

model DeviceHistory {
  id        String   @id @default(cuid())
  deviceId  String
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  action    String
  details   String?
  userId    String?
  createdAt DateTime @default(now())
}


model ApiKey {
  id        String    @id
  name      String
  keyHash   String    @unique
  createdAt DateTime  @default(now())
  lastUsed  DateTime?
  active    Boolean   @default(true)
}

model Setting {
  key   String @id
  value String @db.LongText
}

model MailQueue {
  id          String    @id @default(cuid())
  to          String
  subject     String
  html        String    @db.LongText
  text        String?   @db.LongText
  status      String    @default("PENDING")
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  lastError   String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([status, createdAt])
}

model MailLog {
  id          String   @id @default(cuid())
  direction   String   @default("OUTBOUND")
  fromAddr    String
  toAddr      String
  subject     String
  body        String?   @db.LongText
  status      String
  error       String?
  relatedType String?
  relatedId   String?
  messageId   String?
  createdAt   DateTime @default(now())

  @@index([relatedType, relatedId])
  @@index([createdAt])
}

// ─── Geräte-Updates Modul ────────────────────────────────────────────────────

model DeviceUpdate {
  id        String               @id
  dateTime  DateTime             @default(now())
  location  String
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  results   DeviceUpdateResult[]
  rooms     Room[]               // Many-to-many relation with Room
}

model DeviceUpdateResult {
  id           String       @id @default(cuid())
  updateId     String
  update       DeviceUpdate @relation(fields: [updateId], references: [id], onDelete: Cascade)
  deviceId     String
  device       Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  status       String       // "SUCCESS", "FAILED"
  errorDetails String?      // Description of the problem
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([updateId, deviceId])
}

// ─── E-Mail-Support: Eingehende Mails (Posteingangs-Queue) ───────────────────

model InboundMail {
  id               String    @id @default(cuid())
  imapUid          Int?                        // IMAP UID für Duplikat-Erkennung
  fromAddr         String
  fromName         String?
  subject          String
  body             String    @db.LongText
  bodyHtml         String?   @db.LongText
  status           String    @default("PENDING") // PENDING | CONVERTED | IGNORED
  convertedIssueId String?                     // Verweis auf erstelltes Ticket
  receivedAt       DateTime  @default(now())
  processedAt      DateTime?

  @@index([imapUid])
  @@index([status, receivedAt])
}

// ─── Sequenzen für sprechende IDs (u-1, r-2, l-3, t-4, w-5, k-6) ─────────────

model Sequence {
  key   String @id
  value Int    @default(0)
}
